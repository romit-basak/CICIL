# Secrets
.env

# Python / uv
.venv/
__pycache__/
*.py[cod]
.ipynb_checkpoints/

# Data (CC BY-NC 4.0 shared-task data — not redistributed via this repo)
data/
images/

# Generated Stage 1 outputs: version the prediction JSONLs (the Stage 2 hand-off
# to Mehek), but keep logs and trained adapters out of the repo.
outputs/*.log
outputs/adapters/
# Commons silver JSONLs embed CC BY/BY-SA description text (the `context` field)
# whose attribution lives only in data/external/commons/provenance.csv — keep
# them out of the repo like the images. Regenerable via scripts/silver_caption.py.
outputs/commons*.jsonl
outputs/distill_triples*.jsonl

# Stage 2 FAISS indices: regenerable build artifact (uv run python -m src.stage2.build_index).
# Prediction .txt files under predictions/ are versioned (the Stage 2 hand-off to analysis).
indices/
predictions/_dryrun/

# OS
.DS_Store

# local tool installs must never enter the repo (see 2026-07-29 history rewrite)
google-cloud-sdk/
*.tar.gz

# LaTeX build artifacts (paper builds: keep .tex/.pdf, ignore intermediates)
acl2023/*.aux
acl2023/*.bbl
acl2023/*.blg
acl2023/*.log
acl2023/*.out
